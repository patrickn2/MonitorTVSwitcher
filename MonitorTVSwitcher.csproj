<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonitorTVSwitcher</AssemblyName>
    <RootNamespace>MonitorTVSwitcher</RootNamespace>
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>Monitor/TV Switcher</AssemblyTitle>
    <Product>Monitor/TV Switcher</Product>
    <Company>Monitor/TV Switcher</Company>
    <Description>Switch display, HDR, and audio from a joystick combination.</Description>
    <Version>1.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
  </ItemGroup>

</Project>
